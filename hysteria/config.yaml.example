# Hysteria 2 — параллельный стек на франкфуртском дроплете.
# WireGuard остаётся на udp/443. Hysteria занимает udp/8443.
#
# ЭТО ШАБЛОН. Рабочий файл hysteria/config.yaml генерируется скриптом
# scripts/gen-proxy-secrets.sh НА СЕРВЕРЕ и в git не попадает (.gitignore).
# У Hysteria2 НЕТ подстановки переменных окружения в конфиге — пароль и пути
# обязаны лежать в файле литералами, поэтому файл и не версионируется.

listen: :8443

# --- TLS: самоподписанный сертификат + пиннинг на клиенте ---------------------
# Сознательно НЕ используем ACME/Let's Encrypt. Причины:
#   1. Выпуск сертификата попадает в Certificate Transparency. Имя hy2.halobolan.cc
#      навсегда встало бы в crt.sh рядом с vault.halobolan.cc, публично связывая
#      прокси с менеджером паролей. Для privacy-focused сетапа это регресс.
#   2. ACME через DNS-01 требует держать на диске Cloudflare API-токен с правом
#      правки DNS всей зоны. Лишний секрет на коробке, где живёт Vaultwarden.
#   3. Нет лимитов Let's Encrypt (5 дубликатов в неделю) при итерациях конфига.
# Цена: активный сканер сразу видит нестандартный сертификат. В Австрии угроза —
# шейпер оператора, а не цензор, поэтому цена приемлема.
# Клиент проверяет соответствие по отпечатку (pinSHA256 / certificate в sing-box),
# так что MITM по-прежнему невозможен.
tls:
  cert: /certs/hy2.crt
  key: /certs/hy2.key

auth:
  type: password
  password: REPLACE_ME_openssl_rand_base64_32

# --- УПРАВЛЕНИЕ ПЕРЕГРУЗКОЙ: здесь весь смысл --------------------------------
# Блока `bandwidth:` НЕТ СОЗНАТЕЛЬНО. Его отсутствие означает, что Brutal не
# используется никогда и работает BBR.
#
# Почему не Brutal, хотя именно за него Hysteria2 хвалят:
#   - Замер 45-минутного монитора (2026-08-09) показал, что деградация на этом
#     канале — bufferbloat: RTT раздувается до 1273 мс, и просаживаются ВСЕ
#     потоки, включая идущие мимо туннеля. Это перегруженная очередь, а не
#     полисер.
#   - Brutal намеренно игнорирует потери как сигнал перегрузки и под потерями
#     шлёт до 1.25x заданной полосы (кламп minAckRate=0.8 в brutal.go). На
#     забитой очереди это не «пробивает» канал, а добивает его — и себе, и
#     всем остальным на этом Wi-Fi.
#   - FOCI 2025 (Censored Planet): ниже 20% потерь BBR не уступает Brutal, а
#     когда заданная полоса ниже реальной — превосходит его. Измеренные потери
#     здесь 0.19%, а разброс пропускной способности между прогонами двукратный,
#     то есть любое фиксированное число для Brutal будет неверным почти всегда.
congestion:
  type: bbr
  bbrProfile: standard

# Игнорировать подсказки о полосе от клиента, чтобы телефон со случайно
# оставленным блоком `bandwidth:` не перетащил сервер обратно на Brutal.
ignoreClientBandwidth: true

# --- Разрешение имён: только собственный unbound, мимо публичных резолверов ---
# Домены резолвит сервер, а не клиент. Запросы идут в unbound в docker-сети.
resolver:
  type: udp
  udp:
    addr: 10.4.0.100:53
    timeout: 4s

# --- ACL: КРИТИЧНО ДЛЯ БЕЗОПАСНОСТИ ------------------------------------------
# Без этого блока любой, у кого есть пароль, ходит с прокси во внутренние сети
# дроплета: http://10.2.0.4/ — это Vaultwarden В ОБХОД Cloudflare Access
# (включая /admin, потому что ADMIN_TOKEN выставлен), а 157.230.98.224:22 — SSH,
# который ufw пускает из 10.2.0.0/24.
# Порядок важен: первое совпадение выигрывает, поэтому резолвер разрешаем до
# запретов, а `direct(all)` идёт последним.
acl:
  inline:
    # Выделенный резолвер proxy-net (контейнер unbound-proxy). Ограничение
    # именно портом 53 проверено на живом бинарнике v2.12.1: синтаксис
    # `direct(addr, udp/53)` принимается, а заведомо мусорное правило
    # отвергается с «invalid syntax» — значит валидация реальна, а не мнимая.
    # Резолвер намеренно НЕ имеет ног в vpn-net, поэтому даже эта дырка
    # никуда не ведёт.
    - direct(10.4.0.100, udp/53)
    - reject(10.0.0.0/8)          # vpn-net, wg-подсеть, весь RFC1918
    - reject(172.16.0.0/12)
    - reject(192.168.0.0/16)
    - reject(169.254.0.0/16)      # link-local и метаданные облака
    - reject(127.0.0.0/8)
    - reject(157.230.98.224/32)   # публичный IP самого дроплета — иначе SSH достижим
    - reject(::1/128)
    - reject(fc00::/7)
    - reject(fe80::/10)
    - direct(all)

# --- Маскировка -------------------------------------------------------------
# Кто постучится HTTP/3 без валидной аутентификации — получит проксированный
# настоящий сайт, а не ошибку протокола.
masquerade:
  type: proxy
  proxy:
    url: https://www.zalando.de/
    rewriteHost: true
  # listenHTTP/listenHTTPS намеренно не заданы: tcp/80 и tcp/443 не занимаем,
  # 443/tcp уходит под Xray, 80/tcp остаётся свободным.

# Встроенный speedtest выключен: он позволяет любому аутентифицированному
# клиенту жечь трафик дроплета.
speedTest: false

# UDP-форвардинг нужен для QUIC/HTTP-3 у клиента — оставляем включённым.
disableUDP: false

quic:
  initStreamReceiveWindow: 8388608
  maxStreamReceiveWindow: 8388608
  initConnReceiveWindow: 20971520
  maxConnReceiveWindow: 20971520
  maxIdleTimeout: 30s
  keepAlivePeriod: 10s
