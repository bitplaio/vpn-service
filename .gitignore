# Environment files (contain secrets)
# NB: bare `.env` does NOT match `.env.backup.*` — the glob below is what actually
# protects the timestamped backups that get created before every .env edit.
.env*
!.env.example
*.key
privatekey
publickey

# Generated secrets of any kind — never tracked
secrets/

# Claude Code session logs (private)
.claude/sessions/

# Backups
backups/

# WireGuard generated configs with real keys
wireguard/peers/

# Docker volumes (if mounted locally)
volumes/

# OS files
.DS_Store
Thumbs.db

# Deploy state (local tracking)
.claude/docs/deploy-state.json
