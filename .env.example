# Server
SERVERURL=your.server.ip.or.domain
SERVERPORT=443
TZ=UTC

# WireGuard
PEERS=1
PEERDNS=10.2.0.100
INTERNAL_SUBNET=10.13.13.0

# Vaultwarden
ADMIN_TOKEN=change-me-to-a-secure-random-string
SIGNUPS_ALLOWED=false

# Cloudflare Tunnel
# Get from: Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> <your tunnel> -> token
CLOUDFLARE_TUNNEL_TOKEN=paste-token-here
